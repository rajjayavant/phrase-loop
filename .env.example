# PhraseLoop environment configuration
#
# No secrets are required to run PhraseLoop. The YouTube IFrame Player API is
# loaded from https://www.youtube.com/iframe_api on the client and needs no
# API key for playback embedding.
#
# The default video a first-time visitor sees (when they have no previously
# used link cached). Must be a public, embeddable YouTube video ID.
#
# Optional — the code default lives in src/lib/youtube/default-video.ts and is
# used when this is unset.
NEXT_PUBLIC_DEFAULT_VIDEO_ID=raZBLp4zowg
